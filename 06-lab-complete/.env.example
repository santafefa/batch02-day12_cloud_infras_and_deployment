# .env.example for 06-lab-complete
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control!

# Application Settings
APP_NAME="Production AI Agent"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True # Set to False for production

# Server Settings
HOST="0.0.0.0"
PORT=8000

# API Keys (replace with your actual keys)
OPENAI_API_KEY="sk-your-openai-api-key-here"
AGENT_API_KEY="your-secret-agent-api-key-here"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0" # For local Docker Compose

# Rate Limiting & Cost Guard
RATE_LIMIT_PER_MINUTE=10
MONTHLY_BUDGET_USD=10.0

# Conversation History
CONVERSATION_HISTORY_LENGTH=10
CONVERSATION_HISTORY_TTL_SECONDS=3600

# Logging
LOG_LEVEL="INFO" # DEBUG, INFO, WARNING, ERROR, CRITICAL